# Private working projects, narration, and generated deliverables.
/projects/
/episodes/
/work/
/tmp/
**/input/
**/inputs/
**/output/
**/outputs/
**/renders/
**/reels/
**/videos/
**/recordings/
**/reviews/
**/cache/
**/.cache/

# Media is created in project workspaces, never shipped with the skill.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4v
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.aiff
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
# Explicit shared procedural SFX are production dependencies, not narration.
!engine/assets/audio/*.wav
!engine/assets/reconstruction-sound/*.wav

# No opaque old runtime bundles or historical fixture archives.
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.bin

# Dependencies and local machine state.
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*.so
.env
.env.*
!.env.example
!.env.sample
credentials.json
credentials.local.*
*.key
*.pem
id_rsa
id_ed25519
.idea/
.vscode/
.DS_Store
